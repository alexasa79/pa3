{
  "manifest_version": 3,
  "name": "PA3",
  "version": "0.1.0",
  "description": "Read web pages aloud with PA3.",
  "icons": {
    "16": "icons/pa3-wave.png",
    "32": "icons/pa3-wave.png",
    "48": "icons/pa3-wave.png",
    "128": "icons/pa3-wave.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "PA3",
    "default_icon": {
      "16": "icons/pa3-wave.png",
      "32": "icons/pa3-wave.png",
      "48": "icons/pa3-wave.png",
      "128": "icons/pa3-wave.png"
    }
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Toggle PA3 overlays"
    },
    "pause-playback": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Pause or resume narration"
    },
    "previous-sentence": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Previous sentence"
    },
    "next-sentence": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Next sentence"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "frame_detection.js",
        "sentence.js",
        "ordered_list_narration.js",
        "overlay_geometry.js",
        "hover_bounds.js",
        "highlight_ranges.js",
        "highlight_progress.js",
        "highlight_theme.js",
        "playback_history.js",
        "controls_navigation.js",
        "narration_text.js",
        "math_narration.js",
        "editor_narration.js",
        "prose_paragraphs.js",
        "time_stretch.js",
        "stream_audio.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
