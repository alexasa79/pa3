{
  "manifest_version": 3,
  "name": "Reedah",
  "version": "0.1.0",
  "description": "Overlay controls to narrate paragraph text on a page.",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Reedah"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Toggle Reedah overlays"
    },
    "pause-playback": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Pause or resume narration"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "frame_detection.js",
        "sentence.js",
        "ordered_list_narration.js",
        "overlay_geometry.js",
        "hover_bounds.js",
        "highlight_ranges.js",
        "highlight_progress.js",
        "highlight_theme.js",
        "playback_history.js",
        "controls_navigation.js",
        "narration_text.js",
        "time_stretch.js",
        "stream_audio.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.officeapps.live.com/*"
      ],
      "all_frames": true,
      "js": [
        "frame_detection.js",
        "sentence.js",
        "ordered_list_narration.js",
        "overlay_geometry.js",
        "hover_bounds.js",
        "highlight_ranges.js",
        "highlight_progress.js",
        "highlight_theme.js",
        "playback_history.js",
        "controls_navigation.js",
        "narration_text.js",
        "time_stretch.js",
        "stream_audio.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
